{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "copy-schemas": "node scripts/copy-schemas.js",
    "copy-content": "node scripts/copy-content.js",
    "copy-assets": "npm run copy-schemas && npm run copy-content",
    "dev": "npm run copy-assets && astro dev",
    "build": "npm run copy-assets && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@dagrejs/dagre": "^3.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "@xyflow/svelte": "^1.6.2",
    "astro": "^7.0.9",
    "daisyui": "^5.6.18",
    "highlight.js": "^11.11.1",
    "svelte": "^5.56.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
