<xs:documentation>Screening step</xs:documentation>
</xs:annotation>
</xs:enumeration>
<xs:enumeration value="Unload">
<xs:annotation>
<xs:documentation>Unloading step</xs:documentation>
</xs:annotation>
</xs:enumeration>
</xs:restriction>
